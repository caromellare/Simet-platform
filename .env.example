# ─── Vercel Postgres (copiar desde Vercel → Storage → .env.local) ───
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ─── Auth ────────────────────────────────────────────────────────────
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ─── Metricool ───────────────────────────────────────────────────────
# Encontrás el token en: Metricool > Configuración de cuenta > API > Token de acceso
METRICOOL_USER_TOKEN=your_token_here
METRICOOL_USER_ID=1010863

# ─── Marca por defecto ───────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_BRAND_ID=1674000
NEXT_PUBLIC_DEFAULT_BRAND_NAME=Simet Fábrica
